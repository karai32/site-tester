<%# Пагинация. Нужны pagination (из src/pagination.js), pageUrl(номер) и noun — слово для «из N …». %>
<% if (pagination.pagesCount > 1) { %>
	<div class="row align-items-center g-3 mt-1">
		<div class="col-sm-5"><div class="dataTables_info" role="status">Показаны <%= pagination.from %>–<%= pagination.to %> из <%= pagination.total %> <%= noun %></div></div>
		<div class="col-sm-7">
			<div class="dataTables_paginate paging_simple_numbers p-0">
				<ul class="pagination justify-content-sm-end mb-0">
					<li class="paginate_button page-item previous <%= pagination.page === 1 ? 'disabled' : '' %>">
						<a href="<%= pageUrl(pagination.page - 1) %>" class="page-link">Назад</a>
					</li>
					<% for (const number of pagination.numbers) { %>
						<% if (number === '…') { %>
							<li class="paginate_button page-item disabled"><span class="page-link">…</span></li>
						<% } else { %>
							<li class="paginate_button page-item <%= number === pagination.page ? 'active' : '' %>"><a href="<%= pageUrl(number) %>" class="page-link"><%= number %></a></li>
						<% } %>
					<% } %>
					<li class="paginate_button page-item next <%= pagination.page === pagination.pagesCount ? 'disabled' : '' %>">
						<a href="<%= pageUrl(pagination.page + 1) %>" class="page-link">Вперёд</a>
					</li>
				</ul>
			</div>
		</div>
	</div>
<% } %>
