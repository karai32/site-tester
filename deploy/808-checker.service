# Служба systemd. На сервере: /etc/systemd/system/808-checker.service
#   systemctl status 808-checker     — работает ли
#   journalctl -u 808-checker -f     — логи
#   systemctl restart 808-checker    — перезапуск (идущая проверка прервётся)

[Unit]
Description=808 Checker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=checker
Group=checker
WorkingDirectory=/opt/808-checker
EnvironmentFile=/etc/808-checker.env
ExecStart=/usr/bin/node src/server.js
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
