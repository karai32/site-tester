{
  "name": "site-checker",
  "version": "0.1.0",
  "private": true,
  "description": "Проверка одного настроенного сайта с помощью Fastify и Playwright Test",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "pw:install": "playwright install chromium"
  },
  "dependencies": {
    "@fastify/static": "^10.1.3",
    "@playwright/test": "^1.62.1",
    "better-sqlite3": "^13.0.3",
    "fastify": "^5.12.1"
  }
}
