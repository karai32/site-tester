<%#
	Справка по API. Примеры - настоящие запросы и ответы с тестового сервера (src/api/examples.json).
	Нужны apiUrl и sections: [{ title, examples: [{ title, note, request, status, response }] }].
%>
<div class="breadcrumbs"><a href="/settings">Настройки</a> / <span>Справка по API</span></div>

<div class="page-head">
	<div>
		<h1 class="page-title">Справка по API</h1>
	</div>
</div>

<section class="panel">
	<h2 class="panel__title">Как подключиться</h2>
	<table class="api-table">
		<tr><th>Адрес</th><td><code><%= apiUrl %></code></td></tr>
		<tr><th>Ключ</th><td>Заголовок в каждом запросе: <code>Authorization: Bearer &lt;ключ&gt;</code>. Ключ создаётся в <a href="/settings">Настройках</a>. Запросы выполняются от имени того, кто создал ключ.</td></tr>
		<tr><th>Тело запроса</th><td>JSON с заголовком <code>Content-Type: application/json</code> (кроме загрузки аватарки). У запросов без тела этот заголовок не передавать.</td></tr>
		<tr><th>Ответ</th><td>Успех: <code>{"ok": true, "data": ...}</code>, ошибка: <code>{"ok": false, "error": {...}}</code>.</td></tr>
		<tr><th>Списки</th><td>По страницам: <code>?page=2&amp;perPage=20</code> (по умолчанию 10, максимум 100). В <code>meta</code> номер страницы и сколько всего.</td></tr>
		<tr><th>Даты</th><td>В UTC: <code>2026-10-20T06:00:00Z</code>. Время в расписании московское: <code>"17:00"</code>.</td></tr>
	</table>
</section>

<section class="panel">
	<h2 class="panel__title">Коды ошибок</h2>
	<table class="api-table">
		<tr><th><code>400 validation_failed</code></th><td>Неверные данные. В <code>fields</code> указано, какое поле не так.</td></tr>
		<tr><th><code>400 bad_request</code></th><td>Запрос не разобран, например неверный JSON.</td></tr>
		<tr><th><code>401 unauthorized</code></th><td>Нет ключа, ключ неверный или удалён.</td></tr>
		<tr><th><code>404 not_found</code></th><td>Нет такого объекта.</td></tr>
		<tr><th><code>409 conflict</code></th><td>Сейчас нельзя: сценарий выключен, проверка уже закончилась и т. п.</td></tr>
		<tr><th><code>500 server_error</code></th><td>Ошибка на стороне сервиса.</td></tr>
	</table>
</section>

<%# Разделы: ссылки наверху и таблица на каждый запрос %>
<nav class="api-sections">
	<% sections.forEach((section, index) => { %>
		<a href="#api-section-<%= index %>" class="btn btn-outline-primary btn-pill btn-pill-sm"><%= section.title %></a>
	<% }) %>
</nav>

<% sections.forEach((section, index) => { %>
	<section class="panel" id="api-section-<%= index %>">
		<h2 class="panel__title"><%= section.title %></h2>
		<% for (const example of section.examples) { %>
			<table class="api-table api-example">
				<tr>
					<td colspan="2" class="api-example__head">
						<span class="api-example__title"><%= example.title %></span>
						<% if (example.note) { %><span class="api-example__note"><%= example.note %></span><% } %>
					</td>
				</tr>
				<tr><th>Запрос</th><td><pre><%= example.request.join('\n') %></pre></td></tr>
				<tr><th>Ответ <%= example.status %></th><td><pre><%= example.response.join('\n') %></pre></td></tr>
			</table>
		<% } %>
	</section>
<% }) %>
