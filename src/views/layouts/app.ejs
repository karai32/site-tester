<!doctype html>
<html lang="ru">
<head>
	<%- include('../partials/head') %>
</head>
<body>
	<div class="app">
		<%# На телефоне меню прячется, вместо него - полоса с логотипом и кнопкой меню %>
		<div class="app-topbar">
			<a href="/" class="app-logo"><img src="/assets/img/logo-mark-light.svg" width="35" height="35" alt=""><span>808 Checker</span></a>
			<button type="button" class="app-topbar__menu" data-mobile-open aria-label="Меню"><img src="/assets/img/bar-icon-light.svg" width="18" height="15" alt=""></button>
		</div>

		<%- include('../partials/sidebar') %>

		<main class="app-main">
			<%- body %>
		</main>

		<div class="app-overlay" data-mobile-close></div>
	</div>

	<script src="/assets/js/jquery-3.7.1.min.js"></script>
	<script src="/assets/js/bootstrap.bundle.min.js"></script>
	<%# Поле с «чипами» (data-role="tagsinput") - плагин из UI-кита %>
	<script src="/assets/js/tagsinput.js"></script>
	<script src="/assets/js/app.js"></script>
</body>
</html>
