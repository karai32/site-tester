<div class="login-wrapper login-center">
	<div class="loginbox">
		<div class="login-right">
			<h2>Вход в аккаунт</h2>
			<p class="account-subtitle">Введите логин и пароль для доступа к панели</p>

			<%# data-login-form: app.js делает кнопку «Войти» серой, пока логин или пароль не заполнены %>
			<form method="post" action="/login" data-login-form>
				<div class="input-block">
					<label for="login">Логин</label>
					<input class="form-control" id="login" name="login" type="text" placeholder="Введите логин" value="<%= login %>" autocomplete="username" required <%= error ? '' : 'autofocus' %>>
				</div>
				<div class="input-block">
					<label for="password">Пароль</label>
					<div class="position-relative">
						<input class="form-control pass-input" id="password" name="password" type="password" placeholder="Введите пароль" autocomplete="current-password" required <%= error ? 'autofocus' : '' %>>
						<span class="profile-views feather-eye-off toggle-password"></span>
					</div>
				</div>

				<% if (error) { %>
					<div class="alert alert-danger" role="alert">
						<div class="d-flex align-items-start gap-2">
							<i class="feather-x-circle" style="font-size:18px;margin-top:1px"></i>
							<div><strong>Неверный логин или пароль</strong><div style="font-size:12px">Проверьте раскладку и попробуйте ещё раз</div></div>
						</div>
					</div>
				<% } %>

				<div class="login-btn mb-0">
					<button class="btn btn-primary btn-block" type="submit">Войти</button>
				</div>
			</form>
		</div>
	</div>
</div>
