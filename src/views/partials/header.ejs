<div class="header">
	<div class="header-left">
		<a href="/" class="logo"><img src="/assets/img/logo-mark.svg" width="35" height="35" alt=""><span>808 Checker</span></a>
	</div>
	<a id="toggle_btn" href="#" data-toggle-mini aria-label="Свернуть меню"><i class="feather-menu"></i></a>
	<a class="mobile_btn" href="#" data-mobile-open aria-label="Меню"><i class="feather-menu"></i></a>

	<ul class="nav user-menu float-end">
		<li class="nav-item dropdown has-arrow user-profile-list">
			<a href="#" class="dropdown-toggle nav-link user-link" data-bs-toggle="dropdown">
				<div class="user-names"><h5><%= shortName(user.name) %></h5><span><%= user.login %></span></div>
				<span class="user-img"><span class="avatar"><%= initials(user.name) %></span></span>
			</a>
			<div class="dropdown-menu dropdown-menu-end">
				<a class="dropdown-item" href="/profile">Профиль</a>
				<form method="post" action="/logout">
					<button class="dropdown-item" type="submit">Выйти</button>
				</form>
			</div>
		</li>
	</ul>
</div>
