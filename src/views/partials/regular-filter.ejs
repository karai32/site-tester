<%#
	Фильтр «Регулярность: Все / Регулярные / Нерегулярные» для списка сценариев и архива.
	Нужны regular ('yes', 'no' или '' — все) и filterUrl — адрес списка с изменёнными фильтрами.
%>
<%
	let regularTitle = 'Все';
	if (regular === 'yes') regularTitle = 'Регулярные';
	if (regular === 'no') regularTitle = 'Нерегулярные';
%>
<div class="dropdown">
	<button type="button" class="filter-pill dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
		Регулярность: <%= regularTitle %> <i class="feather-chevron-down"></i>
	</button>
	<div class="dropdown-menu">
		<a class="dropdown-item <%= regular === '' ? 'active' : '' %>" href="<%= filterUrl({ regular: '' }) %>">Все</a>
		<a class="dropdown-item <%= regular === 'yes' ? 'active' : '' %>" href="<%= filterUrl({ regular: 'yes' }) %>">Регулярные</a>
		<a class="dropdown-item <%= regular === 'no' ? 'active' : '' %>" href="<%= filterUrl({ regular: 'no' }) %>">Нерегулярные</a>
	</div>
</div>
