<%# Один тест в отчёте. Нужен result — строка из report_results. %>
<% const PROBLEMS_SHOWN = 3; %>
<div class="test-item__head">
	<% if (result.passed) { %>
		<i class="feather-check-circle text-success test-item__icon"></i>
	<% } else { %>
		<i class="feather-alert-circle text-danger test-item__icon"></i>
	<% } %>

	<div class="test-item__body">
		<div class="test-item__title"><%= result.test_title %></div>
		<div class="test-item__comment"><%= result.comment %></div>

		<% if (result.problems.length > 0) { %>
			<ul class="test-item__problems">
				<% result.problems.forEach((problem, index) => { %>
					<li class="<%= index >= PROBLEMS_SHOWN ? 'd-none' : '' %>" <%= index >= PROBLEMS_SHOWN ? 'data-more-item' : '' %>><%= problem %></li>
				<% }) %>
			</ul>
			<% if (result.problems.length > PROBLEMS_SHOWN) { %>
				<button type="button" class="more-chip" data-show-more>Показать ещё <%= result.problems.length - PROBLEMS_SHOWN %> <i class="feather-chevron-down"></i></button>
			<% } %>
		<% } %>

		<% if (result.pages.length > 0) { %>
			<div class="test-item__pages">
				<%= result.pages.length > 1 ? 'Страницы:' : 'Страница:' %>
				<% result.pages.forEach((pageUrl, index) => { %>
					<a href="<%= pageUrl %>" target="_blank" rel="noopener"><%= displayUrl(pageUrl) %></a><%= index < result.pages.length - 1 ? ',' : '' %>
				<% }) %>
			</div>
		<% } %>

		<% if (result.media.length > 0) { %>
			<div class="media-tiles">
				<% result.media.forEach((item, index) => { %>
					<% const isVideo = item.file.endsWith('.webm'); %>
					<button type="button" class="media-tile" data-media="/media/<%= item.file %>" data-media-type="<%= isVideo ? 'video' : 'image' %>"
						data-media-caption="<%= item.caption || `${result.test_title} — ${isVideo ? 'видео' : `скриншот ${index + 1}`}` %>"
						title="<%= item.caption || (isVideo ? 'Видео' : 'Скриншот') %>">
						<i class="<%= isVideo ? 'feather-film' : 'feather-image' %>"></i>
					</button>
				<% }) %>
			</div>
		<% } %>
	</div>

	<span class="custom-badge status-<%= result.passed ? 'green' : 'red' %>"><%= result.passed ? 'Успешно' : 'Провалено' %></span>
</div>
