<%#
	Сводка по сценарию на дашборде (ТЗ, п. 9): отчёты сценария от самого недавнего до самого первого.
	Сервер отдаёт её кусочком HTML, app.js вставляет в блок «Сводка по сценарию», когда сценарий выбран в списке.
%>
<div class="scenario-summary">
	<% if (reports.length === 0) { %>
		<p class="panel__empty">По этому сценарию ещё не было проверок</p>
	<% } else { %>
		<%# «Показать ещё» подгружает следующие отчёты %>
		<%- include('scenario-summary-rows', { reports, remaining, nextUrl }) %>
	<% } %>
</div>
