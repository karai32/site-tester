<div class="page-head">
	<div>
		<h1 class="page-title">Страница профиля</h1>
		<p class="page-subtitle">Данные аккаунта</p>
	</div>
</div>

<section class="panel profile-head">
	<%- include('partials/project-logo', { project, className: 'avatar' }) %>
	<div>
		<h2 class="profile-head__name"><%= project.name %></h2>
		<p class="profile-head__email">Логин: <%= project.login %></p>
	</div>
</section>

<% if (saved) { %>
	<div class="alert alert-success" role="alert">Профиль сохранён</div>
<% } %>

<div class="row g-4">
	<div class="col-xl-6">
		<form class="panel" method="post" action="/profile">
			<h2 class="panel__title">Контакты для уведомлений</h2>
			<% if (errors.length > 0) { %>
				<div class="alert alert-danger mt-3" role="alert">
					<% for (const error of errors) { %><div><%= error %></div><% } %>
				</div>
			<% } %>
			<div class="field">
				<label for="profile-email">Почта</label>
				<input id="profile-email" name="email" type="email" class="form-control" value="<%= contacts.email %>" placeholder="name@808.ru">
			</div>
			<div class="field">
				<label for="profile-telegram">Telegram ID</label>
				<input id="profile-telegram" name="telegram_id" class="form-control" value="<%= contacts.telegramId %>" inputmode="numeric">
				<% if (TELEGRAM_BOT_NAME) { %>
					<p class="field__hint">Напишите боту <a href="https://t.me/<%= TELEGRAM_BOT_NAME %>" target="_blank" rel="noopener">@<%= TELEGRAM_BOT_NAME %></a>, он пришлёт ваш ID</p>
				<% } else { %>
					<p class="field__hint">Telegram-бот ещё не подключён</p>
				<% } %>
			</div>
			<div class="panel__actions">
				<button type="submit" class="btn btn-primary btn-pill">Сохранить</button>
			</div>
		</form>
	</div>
</div>
