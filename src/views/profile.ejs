<div class="page-head">
	<div>
		<h1 class="page-title">Страница профиля</h1>
		<p class="page-subtitle">Данные аккаунта и доступные проекты</p>
	</div>
</div>

<section class="panel profile-head">
	<span class="avatar"><%= initials(user.name) %></span>
	<div>
		<h2 class="profile-head__name"><%= user.login %></h2>
		<p class="profile-head__email"><%= user.email || 'Почта не указана' %></p>
	</div>
</section>

<% if (saved) { %>
	<div class="alert alert-success" role="alert">Профиль сохранён</div>
<% } %>

<div class="row g-4">
	<div class="col-xl-6">
		<%# Имя и логин меняет администратор, почту и Telegram ID — сам пользователь %>
		<form class="panel" method="post" action="/profile">
			<h2 class="panel__title">Данные аккаунта</h2>
			<% if (errors.length > 0) { %>
				<div class="alert alert-danger mt-3" role="alert">
					<% for (const error of errors) { %><div><%= error %></div><% } %>
				</div>
			<% } %>
			<div class="field">
				<label for="profile-name">Имя</label>
				<input id="profile-name" class="form-control" value="<%= user.name %>" readonly>
			</div>
			<div class="field">
				<label for="profile-login">Логин</label>
				<input id="profile-login" class="form-control" value="<%= user.login %>" readonly>
			</div>
			<div class="field">
				<label for="profile-email">Почта</label>
				<input id="profile-email" name="email" type="email" class="form-control" value="<%= contacts.email %>" placeholder="name@808.ru">
			</div>
			<div class="field">
				<label for="profile-telegram">Telegram ID</label>
				<input id="profile-telegram" name="telegram_id" class="form-control" value="<%= contacts.telegramId %>" placeholder="Например, 123456789" inputmode="numeric">
				<% if (TELEGRAM_BOT_NAME) { %>
					<p class="field__hint">Напишите боту <a href="https://t.me/<%= TELEGRAM_BOT_NAME %>" target="_blank" rel="noopener">@<%= TELEGRAM_BOT_NAME %></a> любое сообщение — он ответит вашим ID. Без этого бот не сможет присылать вам уведомления.</p>
				<% } else { %>
					<p class="field__hint">Telegram-бот ещё не подключён к сервису</p>
				<% } %>
			</div>
			<div class="panel__actions">
				<button type="submit" class="btn btn-primary btn-pill">Сохранить</button>
			</div>
		</form>
	</div>

	<div class="col-xl-6">
		<section class="panel">
			<div class="panel__head">
				<h2 class="panel__title">Доступные проекты</h2>
			</div>
			<% if (sidebarProjects.length === 0) { %>
				<p class="panel__empty">Проектов пока нет</p>
			<% } %>
			<% for (const item of sidebarProjects) { %>
				<a class="project-row" href="/projects/<%= item.id %>">
					<%- include('partials/project-logo', { project: item }) %>
					<span><%= item.name %></span>
				</a>
			<% } %>
		</section>
	</div>
</div>
