<div class="breadcrumbs"><a href="/projects">Проекты</a> / <span><%= project.name %></span></div>

<div class="page-head">
	<div class="project-head">
		<div class="project-logo"><%= initials(project.name) %></div>
		<div>
			<h1 class="page-title"><%= project.name %></h1>
			<p class="page-subtitle"><i class="feather-link"></i><a href="<%= project.url %>" target="_blank" rel="noopener"><%= displayUrl(project.url) %></a></p>
		</div>
	</div>
</div>

<div class="row g-4">
	<div class="col-xl-8">
		<%# Сценарии и запуск проверки %>
		<section class="panel">
			<div class="panel__head">
				<h2 class="panel__title">Сценарии проверки</h2>
				<span class="panel__meta"><%= scenarios.length %> из <%= scenarios.length %></span>
			</div>

			<% if (scenarios.length === 0) { %>
				<p class="panel__empty">Активных сценариев нет</p>
			<% } %>
			<% for (const scenario of scenarios) { %>
				<div class="list-row">
					<div class="list-row__main">
						<h3 class="scenario-row__title"><%= scenario.name %></h3>
						<span class="author-chip"><span class="avatar"><%= initials(authorName(scenario.author_name)) %></span><%= authorName(scenario.author_name) %></span>
						<a href="/projects/<%= project.id %>/scenarios/<%= scenario.id %>" class="scenario-row__link">Страница сценария</a>
					</div>
					<button type="button" class="btn btn-primary btn-pill" data-bs-toggle="modal" data-bs-target="#launch-<%= scenario.id %>">Запустить</button>
				</div>
			<% } %>

			<a href="/projects/<%= project.id %>/scenarios" class="btn btn-outline-primary btn-pill w-100 panel__footer">Смотреть все сценарии</a>

		</section>

		<%# Окна подтверждения запуска — по одному на сценарий %>
		<% for (const scenario of scenarios) { %>
			<%- include('../partials/launch-modal', { scenario, summary: scenario.summary }) %>
		<% } %>

		<%# Сводка по последней полной проверке %>
		<section class="panel">
			<div class="panel__head">
				<h2 class="panel__title">Сводка по последней полной проверке сайта<br><%= displayUrl(project.url) %></h2>
			</div>
			<% if (!lastFull) { %>
				<p class="panel__empty">Полной проверки ещё не было</p>
			<% } else { %>
				<div class="info-row"><span class="info-row__label">Дата проведения</span><span class="info-row__value"><%= formatDateShort(lastFull.finished_at) %></span></div>
				<div class="info-row"><span class="info-row__label">Проверено страниц</span><span class="info-row__value"><%= lastFull.pages_count %></span></div>
				<div class="info-row"><span class="info-row__label">Успешных проверок</span><span class="info-row__value"><%= lastFull.tests_passed %>/<%= lastFull.tests_total %> · <%= percentOf(lastFull.tests_passed, lastFull.tests_total) %>%</span></div>
				<div class="stat-tiles">
					<% for (const category of lastFullCategories) { %>
						<div class="stat-tile" title="<%= category.title %>">
							<span class="stat-tile__value"><%= category.passedCount %>/<%= category.results.length %></span>
							<span class="stat-tile__label"><%= category.shortTitle %></span>
						</div>
					<% } %>
				</div>
				<a href="/reports/<%= lastFull.id %>" class="btn btn-outline-primary btn-pill w-100 panel__footer">Открыть отчёт</a>
			<% } %>
		</section>
	</div>

	<div class="col-xl-4">
		<%# Сводка по последней частичной проверке %>
		<section class="panel">
			<div class="panel__head">
				<h2 class="panel__title">Последняя частичная проверка</h2>
			</div>
			<% if (!lastPartial) { %>
				<p class="panel__empty">Частичных проверок ещё не было</p>
			<% } else { %>
				<div class="info-row"><span class="info-row__label">Сценарий</span><span class="info-row__value"><%= lastPartial.scenario_name %></span></div>
				<div class="info-row"><span class="info-row__label">Дата проведения</span><span class="info-row__value"><%= formatDateShort(lastPartial.finished_at) %></span></div>
				<div class="info-row"><span class="info-row__label">Проверено страниц</span><span class="info-row__value"><%= lastPartial.pages_count %></span></div>
				<div class="info-row"><span class="info-row__label">Успешных проверок</span><span class="info-row__value"><%= lastPartial.tests_passed %>/<%= lastPartial.tests_total %> · <%= percentOf(lastPartial.tests_passed, lastPartial.tests_total) %>%</span></div>
				<a href="/reports/<%= lastPartial.id %>" class="btn btn-outline-primary btn-pill w-100 panel__footer">Открыть отчёт</a>
			<% } %>
		</section>

		<%# Ближайшие проверки: отложенные и по расписанию %>
		<section class="panel">
			<div class="panel__head">
				<h2 class="panel__title">Ближайшие проверки</h2>
			</div>
			<% if (upcoming.length === 0) { %>
				<p class="panel__empty">Запланированных проверок нет</p>
			<% } %>
			<% for (const run of upcoming) { %>
				<div class="info-row">
					<span class="info-row__label">
						<a href="/projects/<%= project.id %>/scenarios/<%= run.scenario.id %>"><%= run.scenario.name %></a>
						<span class="info-row__note"><%= run.isRegular ? 'По расписанию' : 'Отложенная' %></span>
					</span>
					<span class="info-row__value"><%= formatDateShort(run.runAt) %></span>
				</div>
			<% } %>
		</section>
	</div>
</div>

<%# Последние отчёты %>
<section class="panel">
	<div class="panel__head">
		<h2 class="panel__title">Последние отчёты</h2>
		<span class="panel__meta"><a href="/projects/<%= project.id %>/reports">Архив отчётов</a></span>
	</div>
	<% if (recentReports.length === 0) { %>
		<p class="panel__empty">Проверок ещё не было</p>
	<% } %>
	<% for (const report of recentReports) { %>
		<a class="report-link-row" href="/reports/<%= report.id %>">
			<span><%= report.scenario_name %></span>
			<% if (report.status !== 'done') { %>
				<% const status = reportStatus(report); %>
				<span class="custom-badge status-<%= status.color %>"><%= status.label %></span>
			<% } %>
			<span class="report-link-row__date"><%= formatDate(report.finished_at || report.created_at) %></span>
		</a>
	<% } %>
</section>

<%# Сводка по сценарию (ТЗ, п. 9): по умолчанию пустая, появляется после выбора сценария в списке %>
<section class="panel">
	<div class="panel__head">
		<h2 class="panel__title">Сводка по сценарию</h2>
	</div>
	<select class="form-select summary-select" aria-label="Сценарий для сводки"
		data-scenario-summary-select data-url="/projects/<%= project.id %>/scenario-summary">
		<option value="">Выберите сценарий</option>
		<% for (const scenario of summaryScenarios) { %>
			<option value="<%= scenario.id %>"><%= scenario.name %> — <%= authorName(scenario.author_name) %></option>
		<% } %>
	</select>
	<div data-scenario-summary></div>
</section>
