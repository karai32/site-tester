<div class="page-head">
	<div>
		<h1 class="page-title">Проекты</h1>
		<p class="page-subtitle">Сайты, которые проверяет сервис</p>
	</div>
</div>

<section class="panel">
	<% if (projects.length === 0) { %>
		<p class="text-muted-2 mb-0">Проектов пока нет. Добавьте проект командой <code>npm run add-project</code></p>
	<% } %>
	<% for (const project of projects) { %>
		<div class="list-row">
			<span class="project-logo"><%= initials(project.name) %></span>
			<div class="list-row__main">
				<h3 class="list-row__title"><%= project.name %></h3>
				<div class="list-row__sub"><%= displayUrl(project.url) %></div>
			</div>
			<a href="/projects/<%= project.id %>" class="btn btn-outline-primary btn-pill btn-pill-sm">Открыть</a>
		</div>
	<% } %>
</section>
