<% const percent = percentOf(report.tests_passed, report.tests_total); %>
<div class="breadcrumbs">
	<a href="/projects/<%= project.id %>"><%= project.name %></a> /
	<a href="/projects/<%= project.id %>/reports">Архив отчётов</a> /
	<span><%= report.scenario_name %></span>
</div>

<div class="page-head">
	<div>
		<h1 class="page-title"><%= report.scenario_name %></h1>
		<p class="page-subtitle">
			<% if (report.status === 'done') { %>
				Проверка завершена в <%= formatDateTime(report.finished_at) %> · запустил <%= authorName(report.started_by_name) %>
			<% } else { %>
				Отчёт #<%= report.id %> · запустил <%= authorName(report.started_by_name) %>
			<% } %>
		</p>
	</div>
	<% if (report.status === 'done') { %>
		<a href="/reports/<%= report.id %>/download" class="btn btn-primary btn-pill btn-pill-sm"><i class="feather-download"></i> Сохранить</a>
	<% } %>
</div>

<%# Пока проверка идёт, app.js обновляет страницу каждые 5 секунд %>
<% if (report.status === 'queued') { %>
	<section class="panel report-progress" data-auto-refresh="5">
		<h2 class="panel__title">Проверка в очереди</h2>
		<p class="text-muted-2 mt-2 mb-0">Она начнётся, как только закончатся проверки перед ней. Страница обновляется сама.</p>
	</section>
<% } %>

<% if (report.status === 'running') { %>
	<section class="panel report-progress" data-auto-refresh="5">
		<% if (!report.tests_total) { %>
			<h2 class="panel__title">Обход сайта</h2>
			<p class="text-muted-2 mt-2 mb-0">Сервис собирает страницы сайта. На большом сайте это занимает несколько минут.</p>
			<div class="progress"><div class="progress-bar progress-bar-striped progress-bar-animated w-100"></div></div>
		<% } else { %>
			<h2 class="panel__title">Выполнено <%= report.tests_done %> из <%= report.tests_total %> <%= plural(report.tests_total, ['теста', 'тестов', 'тестов']) %></h2>
			<p class="text-muted-2 mt-2 mb-0">Страниц в выборке: <%= report.pages_count %>. Страница обновляется сама.</p>
			<div class="progress"><div class="progress-bar" style="width:<%= percentOf(report.tests_done, report.tests_total) %>%"></div></div>
		<% } %>
	</section>
<% } %>

<% if (report.status === 'error') { %>
	<div class="alert alert-danger" role="alert"><strong>Проверка не выполнена.</strong> <%= report.error %></div>
<% } %>

<% if (report.status === 'done') { %>
	<div class="report-hero">
		<div class="report-hero__ring">
			<svg viewBox="0 0 100 100" aria-hidden="true">
				<circle cx="50" cy="50" r="44" fill="none" stroke-width="12" style="stroke: var(--muted)"></circle>
				<circle cx="50" cy="50" r="44" fill="none" stroke-width="12" transform="rotate(-90 50 50)" stroke-dasharray="<%= ringDash(percent) %>" style="stroke: var(--paper)"></circle>
			</svg>
			<b><%= percent %>%</b>
		</div>
		<div>
			<h2 class="report-hero__title"><%= report.tests_passed %> из <%= report.tests_total %> <%= plural(report.tests_total, ['теста', 'тестов', 'тестов']) %> прошли успешно</h2>
			<p class="report-hero__text">Сводка по проверке · проверено <%= report.pages_count %> <%= plural(report.pages_count, ['страница', 'страницы', 'страниц']) %></p>
		</div>
	</div>
<% } %>

<% if (report.note) { %>
	<div class="alert alert-warning" role="alert"><%= report.note %></div>
<% } %>

<% if (categories.length > 0) { %>
	<div class="search-pill">
		<i class="feather-search"></i>
		<input type="search" class="form-control" placeholder="Найти в отчёте: тест, ошибка, адрес страницы" data-report-search>
	</div>
	<p class="text-muted-2 d-none" data-report-search-empty>По запросу ничего не найдено</p>

	<div class="test-groups">
		<% for (const category of categories) { %>
			<% const badge = category.passedCount === category.results.length ? 'green' : 'orange'; %>
			<section class="test-group report-category">
				<button type="button" class="test-group__head" data-bs-toggle="collapse" data-bs-target="#category-<%= category.id %>" aria-expanded="true">
					<span class="icon-box icon-box-sm"><i class="<%= category.icon %>"></i></span>
					<span class="test-group__title"><%= category.title %></span>
					<span class="custom-badge status-<%= badge %>"><%= category.passedCount %>/<%= category.results.length %></span>
					<i class="feather-chevron-down test-group__arrow"></i>
				</button>
				<div class="collapse show" id="category-<%= category.id %>">
					<% for (const result of category.results) { %>
						<div class="test-item report-test">
							<%- include('../partials/report-test', { result }) %>
						</div>
					<% } %>
				</div>
			</section>
		<% } %>
	</div>
<% } %>

<!-- Скриншот или видео крупно. Файл и подпись подставляет app.js. -->
<div class="modal fade" id="media-modal" tabindex="-1" aria-label="Медиафайл" aria-hidden="true">
	<div class="modal-dialog modal-dialog-centered modal-xl">
		<div class="modal-content">
			<div class="modal-header">
				<h4 class="modal-title" data-media-modal-caption>Медиафайл</h4>
				<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Закрыть"></button>
			</div>
			<div class="modal-body" data-media-modal-body></div>
		</div>
	</div>
</div>
