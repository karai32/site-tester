<div class="breadcrumbs">
	<a href="/projects/<%= project.id %>"><%= project.name %></a> /
	<a href="/projects/<%= project.id %>/scenarios">Сценарии</a> /
	<span><%= scenarioTitle(scenario) %></span>
</div>

<div class="page-head">
	<div>
		<h1 class="page-title">
			<%= scenarioTitle(scenario) %>
			<span class="custom-badge status-<%= scenario.is_active ? 'green' : 'grey' %> align-middle"><%= scenario.is_active ? 'Активный' : 'Неактивный' %></span>
		</h1>
		<p class="page-subtitle">Создан <%= formatDate(scenario.created_at) %><%= scenario.is_full ? ' · полная проверка: все тесты на всех страницах сайта' : '' %></p>
	</div>
	<div class="page-subtitle mt-0">Автор сценария: <span class="author-chip"><span class="avatar"><%= initials(authorName(scenario.author_name)) %></span><%= authorName(scenario.author_name) %></span></div>
</div>

<% if (notice) { %>
	<div class="alert alert-success" role="alert"><%= notice %></div>
<% } %>

<div class="row g-4">
	<div class="col-xl-6">
		<%# Категории и тесты %>
		<section class="panel">
			<div class="panel__head">
				<h2 class="panel__title">Категории и тесты</h2>
				<span class="panel__meta"><%= summary.categories.length %> <%= plural(summary.categories.length, ['категория', 'категории', 'категорий']) %></span>
			</div>
			<% summary.categories.forEach((category, index) => { %>
				<div class="tree-group">
					<button type="button" class="tree-group__head <%= index === 0 ? '' : 'collapsed' %>" data-bs-toggle="collapse" data-bs-target="#tests-<%= category.id %>" aria-expanded="<%= index === 0 %>">
						<span class="icon-box icon-box-sm"><i class="<%= category.icon %>"></i></span>
						<span class="tree-group__title"><%= category.title %></span>
						<span class="tree-group__count"><%= category.tests.length %> <%= plural(category.tests.length, ['тест', 'теста', 'тестов']) %></span>
						<i class="feather-chevron-down tree-group__arrow"></i>
					</button>
					<div class="collapse <%= index === 0 ? 'show' : '' %>" id="tests-<%= category.id %>">
						<ul class="tree-items">
							<% for (const test of category.tests) { %>
								<li><i class="feather-check-circle text-success"></i><%= test.title %></li>
							<% } %>
						</ul>
					</div>
				</div>
			<% }) %>
		</section>

		<%# Выборки страниц %>
		<section class="panel">
			<div class="panel__head">
				<h2 class="panel__title">Выборки тестирования</h2>
			</div>
			<% for (const set of summary.pageSets) { %>
				<div class="check-row"><i class="feather-check-circle text-success"></i><%= set.title %></div>
			<% } %>
		</section>
	</div>

	<div class="col-xl-6">
		<%# Запуск: сейчас (с подтверждением в окне) или отложенный — в выбранные дату и время %>
		<section class="panel">
			<div class="panel__head">
				<h2 class="panel__title">Запуск проверки</h2>
			</div>
			<% if (scenario.is_active) { %>
				<div class="panel__actions">
					<button type="button" class="btn btn-outline-primary btn-pill btn-pill-sm" data-bs-toggle="modal" data-bs-target="#launch-<%= scenario.id %>">Запустить сейчас</button>
					<button type="button" class="btn btn-pill btn-pill-sm btn-soft-warning" data-bs-toggle="collapse" data-bs-target="#deferred-form" aria-expanded="<%= deferredErrors.length > 0 %>">Отложенная проверка</button>
					<% if (scenario.deferred_at) { %>
						<form method="post" action="/projects/<%= project.id %>/scenarios/<%= scenario.id %>/deferred/cancel">
							<button type="submit" class="btn btn-pill btn-pill-sm btn-soft-danger">Отменить отложенную проверку</button>
						</form>
					<% } %>
				</div>

				<%# Дата и время отложенной проверки — по Москве %>
				<div class="collapse <%= deferredErrors.length > 0 ? 'show' : '' %>" id="deferred-form">
					<form class="soft-box deferred-form" method="post" action="/projects/<%= project.id %>/scenarios/<%= scenario.id %>/deferred">
						<% if (deferredErrors.length > 0) { %>
							<div class="alert alert-danger w-100" role="alert">
								<% for (const error of deferredErrors) { %><div><%= error %></div><% } %>
							</div>
						<% } %>
						<div class="deferred-form__field">
							<label for="deferred-date">Дата</label>
							<input type="date" id="deferred-date" name="date" class="form-control" value="<%= deferredForm.date %>" required>
						</div>
						<div class="deferred-form__field">
							<label for="deferred-time">Время</label>
							<input type="time" id="deferred-time" name="time" class="form-control" value="<%= deferredForm.time %>" required>
						</div>
						<button type="submit" class="btn btn-primary btn-pill">Подтвердить</button>
					</form>
				</div>

				<% if (scenario.deferred_at) { %>
					<div class="notice-box notice-box-warning">
						<i class="feather-info"></i>
						<span>Отложенная проверка запланирована на <%= formatDateShort(scenario.deferred_at) %></span>
					</div>
				<% } %>
				<%- include('../partials/launch-modal', { scenario, summary }) %>
			<% } else { %>
				<p class="panel__empty">Сценарий неактивен. Чтобы запустить проверку, сначала активируйте его.</p>
			<% } %>
		</section>

		<%# Регулярность: расписание и кнопка «Изменить», по ней открывается форма %>
		<section class="panel" id="schedule">
			<div class="panel__head">
				<div>
					<h2 class="panel__title">Регулярность проверки</h2>
					<p class="page-subtitle mt-2">Автоматический запуск по расписанию</p>
				</div>
				<% if (scenario.schedule_type) { %>
					<span class="custom-badge status-green">Регулярная</span>
				<% } else { %>
					<span class="custom-badge status-grey">Нерегулярная</span>
				<% } %>
			</div>

			<% if (editSchedule) { %>
				<form method="post" action="/projects/<%= project.id %>/scenarios/<%= scenario.id %>/schedule">
					<% if (scheduleErrors.length > 0) { %>
						<div class="alert alert-danger" role="alert">
							<% for (const error of scheduleErrors) { %><div><%= error %></div><% } %>
						</div>
					<% } %>
					<%- include('../partials/schedule-form', { schedule }) %>
					<div class="panel__actions">
						<button type="submit" class="btn btn-primary btn-pill">Сохранить</button>
						<a href="/projects/<%= project.id %>/scenarios/<%= scenario.id %>" class="btn btn-outline-primary btn-pill">Отменить</a>
					</div>
				</form>
			<% } else { %>
				<div class="soft-box schedule-box">
					<div>
						<span class="schedule-box__label">Расписание</span>
						<span class="schedule-box__value"><%= scheduleText(scenario) %></span>
						<% if (scenario.schedule_type && scenario.is_active) { %>
							<span class="schedule-box__next">Следующий запуск: <%= formatDateShort(scenario.next_run_at) %></span>
						<% } else if (scenario.schedule_type) { %>
							<span class="schedule-box__next">Сценарий неактивен — по расписанию не запускается</span>
						<% } %>
					</div>
					<a href="/projects/<%= project.id %>/scenarios/<%= scenario.id %>?edit=schedule#schedule" class="btn btn-primary btn-pill">Изменить</a>
				</div>
			<% } %>
		</section>

		<%# Уведомления: включённые события и получатели, «Изменить» открывает форму %>
		<section class="panel" id="notifications">
			<div class="panel__head">
				<h2 class="panel__title">Уведомления</h2>
			</div>

			<% if (editNotifications) { %>
				<form method="post" action="/projects/<%= project.id %>/scenarios/<%= scenario.id %>/notifications">
					<% if (notificationErrors.length > 0) { %>
						<div class="alert alert-danger" role="alert">
							<% for (const error of notificationErrors) { %><div><%= error %></div><% } %>
						</div>
					<% } %>
					<%- include('../partials/notifications-form', { notifications }) %>
					<div class="panel__actions">
						<button type="submit" class="btn btn-primary btn-pill">Сохранить</button>
						<a href="/projects/<%= project.id %>/scenarios/<%= scenario.id %>" class="btn btn-outline-primary btn-pill">Отменить</a>
					</div>
				</form>
			<% } else { %>
				<% const enabled = enabledEvents(scenario.notifications); %>
				<% if (enabled.length === 0) { %>
					<p class="panel__empty">По этому сценарию уведомления не отправляются</p>
				<% } %>
				<% for (const { event, channel } of enabled) { %>
					<%
						let recipients = scenario.notifications.emails;
						if (channel === 'telegram') recipients = scenario.notifications.telegramIds;
					%>
					<div class="notify-item">
						<div>
							<span class="notify-item__title"><%= event.title %></span>
							<% if (event.id === 'done' || event.id === 'regular') { %>
								<span class="notify-item__hint">Проверка считается пройденной при успешности от <%= scenario.notifications.passPercent %>%</span>
							<% } %>
						</div>
						<div class="notify-item__to">
							<span class="notify-item__icon" title="<%= channel === 'telegram' ? 'Telegram' : 'Почта' %>"><i class="<%= channel === 'telegram' ? 'feather-send' : 'feather-mail' %>"></i></span>
							<% for (const recipient of recipients) { %>
								<span class="notify-item__chip"><%= recipient %></span>
							<% } %>
						</div>
					</div>
				<% } %>
				<div class="panel__actions">
					<a href="/projects/<%= project.id %>/scenarios/<%= scenario.id %>?edit=notifications#notifications" class="btn btn-primary btn-pill">Изменить</a>
				</div>
			<% } %>
		</section>
	</div>
</div>

<div class="actions-bar">
	<form method="post" action="/projects/<%= project.id %>/scenarios/<%= scenario.id %>/active">
		<% if (scenario.is_active) { %>
			<input type="hidden" name="active" value="0">
			<button type="submit" class="btn btn-pill btn-soft-danger">Деактивировать сценарий</button>
		<% } else { %>
			<input type="hidden" name="active" value="1">
			<button type="submit" class="btn btn-dark btn-pill">Активировать сценарий</button>
		<% } %>
	</form>
	<%# По ТЗ форма редакции открывается в новой вкладке %>
	<a href="/projects/<%= project.id %>/scenarios/<%= scenario.id %>/copy" target="_blank" class="btn btn-outline-primary btn-pill">Скопировать и изменить сценарий</a>
</div>
