<div class="page-head">
	<div>
		<h1 class="page-title">Настройки</h1>
	</div>
</div>

<section class="panel">
	<div class="panel__head">
		<h2 class="panel__title">API-ключ</h2>
		<a href="/settings/api" class="btn btn-outline-primary btn-pill btn-pill-sm"><i class="feather-book-open"></i> Справка по API</a>
	</div>

	<% if (newKey) { %>
		<div class="api-key-new">
			<p class="api-key-new__title">Ключ создан. Скопируйте его: больше он не будет показан.</p>
			<div class="api-key-new__row">
				<input type="text" class="form-control" value="<%= newKey %>" readonly data-select-on-focus aria-label="Новый API-ключ">
				<button type="button" class="btn btn-primary btn-pill" data-copy="<%= newKey %>">Скопировать</button>
			</div>
		</div>
	<% } %>

	<% if (project.key_start) { %>
		<div class="list-row">
			<span class="icon-box icon-box-outline"><i class="feather-lock"></i></span>
			<div class="list-row__main">
				<h3 class="list-row__title"><%= project.key_start %>...</h3>
				<div class="list-row__sub">создан <%= formatDateShort(project.key_created_at) %> · <%= project.key_used_at ? 'использован ' + formatDateShort(project.key_used_at) : 'ещё не использован' %></div>
			</div>
			<form method="post" action="/settings/api-key" data-confirm="Выпустить новый ключ? Запросы со старым сразу перестанут работать.">
				<button type="submit" class="btn btn-pill btn-pill-sm btn-soft-danger">Выпустить новый</button>
			</form>
		</div>
	<% } else { %>
		<p class="panel__empty">Ключа пока нет</p>
		<form class="api-key-form" method="post" action="/settings/api-key">
			<button type="submit" class="btn btn-primary btn-pill">Создать ключ</button>
		</form>
	<% } %>
</section>
